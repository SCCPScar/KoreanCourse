{
  "name": "korean-course",
  "version": "0.1.0",
  "description": "Plataforma web para aprender coreano (한국어), do nível zero ao TOPIK 4, em português europeu.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/serve.js",
    "fonts": "node scripts/copy-fonts.js",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "vendor": "node scripts/copy-vendor.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@fontsource-variable/noto-sans-kr": "^5.3.0",
    "@fontsource/jua": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "vitest": "^5.0.2"
  }
}
